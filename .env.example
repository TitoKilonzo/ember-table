# Appwrite Cloud/ self-hosted project settings. Leave empty for UI demo mode.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=restaurant_commerce
APPWRITE_ORDERS_TABLE_ID=orders
APP_URL=http://localhost:3000
STAFF_ADMIN_EMAIL=admin@embertable.com
STAFF_MANAGER_EMAIL=manager@embertable.com

# Optional Odoo bridge. Implement the companion route in an Odoo custom module.
# Avoid calling pos.order directly until the target session/payment/preparation flow is mapped.
ODOO_BRIDGE_URL=
ODOO_BRIDGE_TOKEN=

# M-Pesa Daraja credentials are intentionally not assumed. Checkout will not claim
# an M-Pesa payment succeeded until a verified callback workflow is implemented.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
